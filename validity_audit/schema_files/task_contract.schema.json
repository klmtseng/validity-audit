{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/klmtseng/validity-audit/schemas/task_contract.schema.json",
  "title": "Validity Audit task contract",
  "description": "The minimal, bounded input for one audit run over one artifact set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "claims",
    "artifact_paths",
    "packs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schema_version": {
      "const": "0.3.0"
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "policy_overrides": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/policyOverride"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "policyOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_class",
        "gate_effect",
        "reason"
      ],
      "properties": {
        "error_class": {
          "$ref": "#/$defs/slug"
        },
        "gate_effect": {
          "enum": [
            "fail",
            "advisory",
            "none"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
