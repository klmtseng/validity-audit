{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/klmtseng/validity-audit/schemas/task_contract.schema.json",
  "title": "Validity Audit task contract",
  "description": "The minimal, bounded input for one audit run over one artifact set.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "claims",
    "artifact_paths",
    "packs"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "schema_version": {
      "enum": ["0.3.0", "0.6.0"]
    },
    "task_id": {
      "$ref": "#/$defs/identifier"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "artifact_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    },
    "policy_overrides": {
      "type": "array",
      "default": [],
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/policyOverride"
      }
    },
    "waiver_issuers": {
      "description": "Restricts the accepted waiver issuer labels for this bounded run; any waiver request whose issuer is not in this list, or any waiver request at all when this is absent, is rejected. This version does not authenticate issuer identity -- attestations are unsigned, so an issuer label is a declared string, not a verified credential.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "\\S"
      }
    },
    "fail_before_pass_after": {
      "$ref": "#/$defs/failBeforePassAfter"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "0.3.0"
          }
        },
        "required": ["schema_version"]
      },
      "then": {
        "properties": {
          "fail_before_pass_after": false
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "allOf": [
        {
          "not": {
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])"
          }
        },
        {
          "not": {
            "pattern": "(^|/)\\.\\.(/|$)"
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "statement"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/identifier"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      }
    },
    "policyOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error_class",
        "gate_effect",
        "reason"
      ],
      "properties": {
        "error_class": {
          "$ref": "#/$defs/slug"
        },
        "gate_effect": {
          "enum": [
            "fail",
            "advisory",
            "none"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "failBeforePassAfter": {
      "description": "Deterministic fail-before/pass-after (FBPA) probe input; see docs/specs/probe-fail-before-pass-after.md.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "head",
        "runner"
      ],
      "properties": {
        "base": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^-]"
        },
        "head": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^-]"
        },
        "runner": {
          "const": "pytest"
        },
        "test_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "claims": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "$ref": "#/$defs/fbpaClaim"
          }
        },
        "auto_discover": {
          "type": "boolean",
          "default": false
        },
        "import_canary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
          }
        },
        "limits": {
          "$ref": "#/$defs/fbpaLimits"
        }
      }
    },
    "fbpaClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "intent"
      ],
      "properties": {
        "test": {
          "description": "A pytest node id: <file>::[<Class>::]<function>[<params>].",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^:-][^:]*::.+$"
        },
        "intent": {
          "enum": [
            "fixes",
            "characterizes"
          ]
        }
      }
    },
    "fbpaLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "memory_max": {
          "type": "string",
          "pattern": "^[1-9][0-9]*[KMGT]?$"
        },
        "timeout_s": {
          "type": "integer",
          "minimum": 1
        },
        "repeats": {
          "description": "Runs per side; at least 2, since a single run cannot detect a flaky test (spec §9).",
          "type": "integer",
          "minimum": 2
        }
      }
    }
  }
}
